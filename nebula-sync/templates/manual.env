# This file is used to configure the nebula-sync manual sync process.
# It is read at runtime and should be placed in the '/etc/nebula-sync' directory.
# Configuration file name: manual.env
# nebula-sync Github repository: https://github.com/lovelaze/nebula-sync

# The following environment variables are required for the manual sync process:
# Specifies the primary Pi-hole configuration sync source. 
# Format: <http://primary-pihole.example.com|password>
PRIMARY=[http://ph1.example.com|password]

# Specifies the replica Pi-hole configurations sync destination. Multiple replicas can be specified, separated by commas.
# Format: <http://replica1-pihole.example.com|password,http://replica2-pihole.example.com|password>
REPLICAS=[http://ph2.example.com|password]

# Enables full synchronization. Set to 'false' for manual Pi-Hole configuration sync.
FULL_SYNC=<[true or false] Default: false>

# Synchronize DNS settings
SYNC_CONFIG_DNS=<[true or false] Default: false>

# Synchronize DHCP settings
SYNC_CONFIG_DHCP=<[true or false] Default: false>

# Synchronize NTP settings
SYNC_CONFIG_NTP=<[true or false] Default: false>

# Synchronize Resolver settings
SYNC_CONFIG_RESOLVER=<[true or false] Default: false>

# Synchronize database settings
SYNC_CONFIG_DATABASE=<[true or false] Default: false>

# Synchronize miscellaneous settings
SYNC_CONFIG_MISC=<[true or false] Default: false>

# Synchronize debug settings
SYNC_CONFIG_DEBUG=<[true or false] Default: false>

# Synchronize DHCP leases
SYNC_GRAVITY_DHCP_LEASES=<[true or false] Default: false>

# Synchronize groups
SYNC_GRAVITY_GROUP=<[true or false] Default: false>

# Synchronize adlists
SYNC_GRAVITY_AD_LIST=<[true or false] Default: false>

# Synchronize adlists by group
SYNC_GRAVITY_AD_LIST_BY_GROUP=<[true or false] Default: false>

# Synchronize domain lists
SYNC_GRAVITY_DOMAIN_LIST=<[true or false] Default: false>

# Synchronize domain lists by group
SYNC_GRAVITY_DOMAIN_LIST_BY_GROUP=<[true or false] Default: false>

# Synchronize clients
SYNC_GRAVITY_CLIENT=<[true or false] Default: false>

# Synchronize clients by group
SYNC_GRAVITY_CLIENT_BY_GROUP=<[true or false] Default: false>

# The following environment variables are optional for the manual sync process:
# Sets the cron schedule for synchronization. Do not use if using a systemd timer.
#CRON=0 * * * *

# Specifies whether to run gravity after syncing
#RUN_GRAVITY=<[true or false] Default: false>

# Specifies the timezone for logs and cron
#TZ=[Continent/city]

# Skips TLS certificate verification
#CLIENT_SKIP_TLS_VERIFICATION=<[true or false] Default: false>

# Seconds to delay between connection attempts
#CLIENT_RETRY_DELAY_SECONDS=<[number] Default: 1>

# Http client timeout in seconds
#CLIENT_TIMEOUT_SECONDS=<[number] Default: 20>
