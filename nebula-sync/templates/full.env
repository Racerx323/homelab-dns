# This file is used to configure the nebula-sync full sync process.
# It is read at runtime and should be placed in the '/etc/nebula-sync' directory.
# Configuration file name: full.env
# nebula-sync Github repository: https://github.com/lovelaze/nebula-sync

# The following environment variables are required for the full sync process:
# Specifies the primary Pi-hole configuration sync source. 
# Format: <http://primary-pihole.example.com|password>
PRIMARY=[http://ph1.example.com|password]

# Specifies the replica Pi-hole configurations sync destination. Multiple replicas can be specified, separated by commas.
# Format: <http://replica1-pihole.example.com|password,http://replica2-pihole.example.com|password>
REPLICAS=[http://ph2.example.com|password]

# Enables full synchronization. Set to 'true' for a full Pi-Hole configuration sync.
FULL_SYNC=[true or false]

# The following environment variables are optional for the full sync process:
# Sets the cron schedule for synchronization. Do not use if using a systemd timer.
#CRON=0 * * * *

# Specifies whether to run gravity after syncing
#RUN_GRAVITY=<[true or false] Default: false>

# Specifies the timezone for logs and cron
#TZ=[Continent/city]

# Skips TLS certificate verification
#CLIENT_SKIP_TLS_VERIFICATION=<[true or false] Default: false>

# Seconds to delay between connection attempts
#CLIENT_RETRY_DELAY_SECONDS=<[number] Default: 1>

# Http client timeout in seconds
#CLIENT_TIMEOUT_SECONDS=<[number] Default: 20>
